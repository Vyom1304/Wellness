  db_calf: ['One calf at a time, with a balance demand.', 'Stand on one foot with the ball of your foot on a step, holding a dumbbell in the same-side hand and a support with the other.|Lower your heel for a deep stretch.|Press up onto your toes.|Lower slowly and finish the reps before switching.', 'Keep the hips level.|Pause at the top.', 'Leaning on the support to cheat.|Using a short range.'],
  bw_calf: ['Calves are isolated, using bodyweight.', 'Stand with the balls of your feet on a step, heels hanging off.|Lower your heels as far as is comfortable.|Rise onto your toes as high as possible.|Lower slowly and repeat.', 'Use a single leg to progress.|Pause at the top.', 'Bouncing through the reps.|Cutting the range short.']
};

function guideFields_(id) {
  const g = EXERCISE_GUIDE_[id];
  if (!g) return null;
  const nl = function (s) { return s.split('|').join('\n'); };
  return { muscle_note: g[0], how_to: nl(g[1]), cues: nl(g[2]), mistakes: nl(g[3]) };
}

